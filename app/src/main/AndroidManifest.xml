<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- FocusGuard never goes online. This strips INTERNET even if a library
         ever asked for it, so the "no internet access" promise in Settings
         is enforced by Android itself. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Haptics on the pause screen -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Restart the watchdog after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Ask to be exempt from battery optimisation so the service is not killed -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Optional, adb-granted only: lets the app switch its own service back on -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets the pause screen show Instagram's real icon, and find the music
         apps it offers after "Long day" -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.jio.media.jiobeats" />
        <package android:name="com.bsbportal.music" />
        <package android:name="com.gaana" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.amazon.mp3" />
        <package android:name="deezer.android.app" />
        <package android:name="com.soundcloud.android" />
        <package android:name="com.miui.player" />
        <package android:name="com.sec.android.app.music" />
        <package android:name="com.heytap.music" />
        <package android:name="com.android.bbkmusic" />
        <package android:name="com.huawei.music" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
    </queries>

    <application
        android:name=".FocusGuardApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusGuard">

        <!-- Main task manager activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FocusGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon → "Add tasks" -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Quick add: the widget's "+" and the icon shortcut -->
        <activity
            android:name=".widget.QuickAddActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FocusGuard.QuickAdd"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible" />

        <!-- Home-screen task widget -->
        <receiver
            android:name=".widget.TaskWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_widget_info" />
        </receiver>

        <!-- Ticks tasks from the widget; only our own taps can reach it -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- Accessibility service to detect app launches -->
        <service
            android:name=".service.AppDetectorService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Boot / update receiver: restart watchdog, repair service -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Once-a-minute liveness check for the accessibility service -->
        <receiver
            android:name=".guard.WatchdogReceiver"
            android:exported="false" />
    </application>

</manifest>
