<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the FocusGuard icon → "Add tasks". -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutId="quick_add"
        android:shortcutLongLabel="@string/shortcut_add_long"
        android:shortcutShortLabel="@string/shortcut_add_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.dhruv.focusguard.widget.QuickAddActivity"
            android:targetPackage="com.dhruv.focusguard" />
    </shortcut>
</shortcuts>
