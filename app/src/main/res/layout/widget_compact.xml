<?xml version="1.0" encoding="utf-8"?>
<!-- Small sizes (2x1, 1x1, narrow): how many are left, what's next, and +. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:paddingStart="12dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/c_open"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/c_count"
                style="@style/WidgetCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="30dp" />

            <LinearLayout
                android:id="@+id/c_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/c_label"
                    style="@style/WidgetSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/c_task"
                    style="@style/WidgetRowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/c_task_urgent"
                    style="@style/WidgetRowTitleUrgent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/c_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_add_bg"
            android:contentDescription="@string/widget_add"
            android:padding="9dp"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>
</FrameLayout>
